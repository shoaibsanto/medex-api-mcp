{
  "name": "medex-api-mcp",
  "version": "0.2.0",
  "description": "An API and Model Context Protocol server for Bangladesh medicine information, retrieved live from medex.com.bd on demand via headless-browser navigation.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "medex-api": "dist/index.js",
    "medex-mcp": "dist/mcp/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "mcp": "node dist/mcp/index.js",
    "mcp:dev": "tsx src/mcp/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:live": "node scripts/live-smoke.mjs",
    "lint": "eslint src tests",
    "openapi:validate": "node scripts/validate-openapi.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "medex",
    "medex.com.bd",
    "bangladesh",
    "medicine-information",
    "rest-api",
    "model-context-protocol",
    "mcp",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "playwright-core": "^1.64.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
