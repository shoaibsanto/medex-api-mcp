# MedEx API + MCP — environment configuration
# Copy to ".env" and adjust as needed. NEVER commit the real ".env" file.

# API server
PORT=3000
HOST=127.0.0.1

# Data provider. "live" (default) drives a headless browser against
# medex.com.bd on demand. "fixture" is an explicit offline development /
# testing mode serving synthetic records — never use it for production data.
MEDEX_PROVIDER=live

# Live browser settings (only used when MEDEX_PROVIDER=live).
# Minimum delay between page navigations (politeness / rate limiting).
MEDEX_REQUEST_DELAY_MS=1200
# Per-navigation timeout in milliseconds.
MEDEX_NAV_TIMEOUT_MS=30000
# Explicit browser executable. When unset, Chrome, then Edge, then the
# Playwright-bundled chromium are tried in that order.
# MEDEX_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# How many generic pages list_category_medicines may expand per call.
MEDEX_CATEGORY_MAX_EXPANSIONS=8

# CORS. Comma-separated list of origins, or "*" for any (dev only).
MEDEX_CORS_ORIGIN=*

# Rate limiting
MEDEX_RATE_LIMIT_MAX=100
MEDEX_RATE_LIMIT_WINDOW_MS=900000
