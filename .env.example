# MedEx API + MCP — environment configuration
# Copy to ".env" and adjust as needed. NEVER commit the real ".env" file.

# API server
PORT=3000
HOST=127.0.0.1

# Data provider. "fixture" is the default and requires no credentials.
# "live" is intentionally NOT supported yet — it throws until an authorized
# live data source is implemented. See DATA_SOURCES.md.
MEDEX_PROVIDER=fixture

# CORS. Comma-separated list of origins, or "*" for any (dev only).
MEDEX_CORS_ORIGIN=*

# Rate limiting
MEDEX_RATE_LIMIT_MAX=100
MEDEX_RATE_LIMIT_WINDOW_MS=900000
